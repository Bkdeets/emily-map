# Copy to .env.local for local dev. On Vercel, set these in Project Settings > Environment Variables.

# Mapbox public token (starts with pk.). Exposed to the browser, so restrict it to your domain in Mapbox.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Upstash Redis. Added automatically when you connect Upstash from the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (photos). Added automatically when you create a Blob store in Vercel Storage.
BLOB_READ_WRITE_TOKEN=

# Ably API key for live location (Ably dashboard > your app > API Keys, the root key is fine).
ABLY_API_KEY=

# Password for adding/editing places and uploading photos (open the site with ?admin).
ADMIN_PASSWORD=

# Optional passcode you both type once before sharing live location. Leave empty to skip.
LIVE_PASSCODE=
